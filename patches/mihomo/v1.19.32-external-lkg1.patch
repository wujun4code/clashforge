+package provider
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/resource"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+	"github.com/metacubex/mihomo/rules/common"
+)
+
+func lkgMrs(t *testing.T, behavior P.RuleBehavior, payload []string) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := ConvertToMrs([]byte(strings.Join(payload, "\n")), behavior, P.TextRule, &buf); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+func TestHTTPRuleProviderFormats(t *testing.T) {
+	useLKGTunnel(t)
+	parse := func(tp, payload, target string, params []string, subRules map[string][]C.Rule) (C.Rule, error) {
+		if tp != "DOMAIN" {
+			return nil, fmt.Errorf("unsupported test rule: %s", tp)
+		}
+		return common.NewDomain(payload, target), nil
+	}
+	cases := []struct {
+		name      string
+		behavior  P.RuleBehavior
+		format    P.RuleFormat
+		good, bad []byte
+	}{
+		{"ipcidr-yaml", P.IPCIDR, P.YamlRule, []byte("payload:\n  - 192.0.2.0/24\n"), []byte("payload: []\n")},
+		{"classical-yaml", P.Classical, P.YamlRule, []byte("payload:\n  - DOMAIN,audit-provider.invalid\n"), []byte("payload: []\n")},
+		{"domain-mrs-malformed", P.Domain, P.MrsRule, lkgMrs(t, P.Domain, []string{"audit-provider.invalid"}), []byte("invalid-mrs")},
+		{"ipcidr-mrs-malformed", P.IPCIDR, P.MrsRule, lkgMrs(t, P.IPCIDR, []string{"192.0.2.0/24"}), []byte("invalid-mrs")},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			// Exercise the shared parser/commit boundary used by HTTP updates
+			// via Fetcher.SideUpdate, without scheduling background pulls.
+			path := filepath.Join(t.TempDir(), "cache")
+			vehicle := resource.NewHTTPVehicle("http://127.0.0.1:1/unused", path, "", nil, 0, 0)
+			p := NewRuleSetProvider(tc.name, tc.behavior, tc.format, 0, vehicle, nil, nil, parse).(*RuleSetProvider)
+			defer p.Close()
+			if _, _, err := p.SideUpdate(tc.good); err != nil {
+				t.Fatal(err)
+			}
+			if p.Count() != 1 {
+				t.Fatalf("valid count = %d", p.Count())
+			}
+			if _, _, err := p.SideUpdate(tc.bad); err == nil {
+				t.Error("bad HTTP parsed strategy accepted")
+			}
+			if p.Count() != 1 {
+				t.Error("bad update lost runtime LKG")
+			}
+			cache, err := os.ReadFile(path)
+			if err != nil || !bytes.Equal(cache, tc.good) {
+				t.Error("bad update lost disk LKG")
+			}
+			if tc.format == P.MrsRule {
+				return // malformed MRS is not a legitimate empty file
+			}
+			// The identical valid empty YAML remains allowed for files.
+			filePath := filepath.Join(t.TempDir(), "empty")
+			if err := os.WriteFile(filePath, tc.bad, 0600); err != nil {
+				t.Fatal(err)
+			}
+			file := NewRuleSetProvider(tc.name, tc.behavior, tc.format, 0, resource.NewFileVehicle(filePath), nil, nil, parse).(*RuleSetProvider)
+			defer file.Close()
+			if err := file.Initial(); err != nil {
+				t.Fatal(err)
+			}
+			if file.Count() != 0 {
+				t.Error("empty file should be allowed")
+			}
+		})
+	}
+}
