#!/bin/sh /etc/rc.common
# /etc/init.d/clashforge — ClashForge procd service script
# Designed to coexist safely with OpenClash

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/clashforge
CONFIG=/etc/metaclash/config.toml
PIDFILE=/var/run/metaclash/metaclash.pid
LOGFILE=/var/log/clashforge.log
MAX_LOG_KB=512
MEM_FLOOR_KB=32768

log() {
    logger -t clashforge "$*"
}

check_memory() {
    local free_kb
    free_kb=$(awk '/MemAvailable/{print $2}' /proc/meminfo 2>/dev/null || \
              awk '/MemFree/{print $2}' /proc/meminfo 2>/dev/null || echo 999999)
    if [ "$free_kb" -lt "$MEM_FLOOR_KB" ]; then
        log "ERROR: insufficient memory (${free_kb}KB free). Aborting start."
        return 1
    fi
    return 0
}

start_service() {
    check_memory || return 1
    # Validate the SAME path the daemon will read, without rewriting user TOML.
    [ -r /usr/share/metaclash/preflight.sh ] || {
        log "ERROR: missing packaged preflight helper"; return 1;
    }
    . /usr/share/metaclash/preflight.sh
    cf_preflight "$CONFIG" || return 1

    mkdir -p /var/run/metaclash
    mkdir -p /etc/metaclash

    # Clean up stale pidfile
    rm -f "$PIDFILE"

    [ -f "$CONFIG" ] || \
        touch "$CONFIG" 2>/dev/null || true
    [ -f /etc/metaclash/overrides.yaml ] || \
        touch /etc/metaclash/overrides.yaml 2>/dev/null || true


    procd_open_instance instance1
    procd_set_param command "$PROG" -config "$CONFIG"
    procd_set_param respawn 3600 10 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    log "clashforge procd instance configured (runtime takeover not yet verified)"
}

stop_service() {
    log "Stopping clashforge..."
}

reload_service() {
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill -HUP "$pid"
        log "Reloaded (SIGHUP sent to pid $pid)"
    else
        log "Not running, starting instead"
        start
    fi
}

service_triggers() {
    procd_add_reload_trigger "network"
}

boot() {
    sleep 5
    start
}
